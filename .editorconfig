# WordPress coding standards: https://developer.wordpress.org/coding-standards/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

# The front-end scripts and styles use two spaces.
[*.{js,cjs,css}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[composer.json]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
