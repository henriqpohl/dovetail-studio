<?xml version="1.0"?>
<ruleset name="Dovetail Studio">
	<description>WordPress Coding Standards for Dovetail Studio and its modules.</description>

	<!-- What is checked. -->
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>
	<!-- Generated by tools/build.php. -->
	<exclude-pattern>/modules/virtual-assistant/src/services/i18n-js.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<!-- WordPress formatting, best practices and security; WordPress-Docs is left out for now. -->
	<rule ref="WordPress-Extra">
		<!-- Class files are named after the class (Loader.php), as the module autoloading expects. -->
		<exclude name="WordPress.Files.FileName"/>
		<!--
		Direct filesystem calls are intended: the plugin only reads its own files and writes to
		folders it owns (uploads/dovetail-va, wp-content/dovetail-modules). WP_Filesystem may ask
		for FTP credentials, which a background save or a visitor's enquiry cannot answer.
		Failures are checked through the return values, so those calls are silenced with @.
		-->
		<exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents"/>
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_is_writable"/>
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_rmdir"/>
		<exclude name="WordPress.WP.AlternativeFunctions.rename_rename"/>
		<exclude name="WordPress.WP.AlternativeFunctions.unlink_unlink"/>
		<exclude name="WordPress.PHP.NoSilencedErrors.Discouraged"/>
	</rule>

	<!-- tools/ holds command-line build scripts, not code that runs inside WordPress. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tools/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tools/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tools/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>/tools/*</exclude-pattern>
	</rule>

	<!--
	Readability: one blank line between functions, around if/foreach/for/while/switch/try blocks
	and before return/continue/break/throw when they follow other code (not at the start of a block).
	All of these are fixed by `composer format`.
	-->
	<rule ref="Squiz.WhiteSpace.FunctionSpacing">
		<properties>
			<property name="spacing" value="1"/>
			<property name="spacingBeforeFirst" value="0"/>
			<property name="spacingAfterLast" value="0"/>
		</properties>
	</rule>
	<rule ref="SlevomatCodingStandard.ControlStructures.BlockControlStructureSpacing">
		<properties>
			<property name="linesCountBefore" value="1"/>
			<property name="linesCountBeforeFirst" value="0"/>
			<property name="linesCountAfter" value="1"/>
			<property name="linesCountAfterLast" value="0"/>
			<property name="controlStructures" type="array">
				<element value="if"/>
				<element value="do"/>
				<element value="while"/>
				<element value="for"/>
				<element value="foreach"/>
				<element value="switch"/>
				<element value="try"/>
			</property>
		</properties>
		<!-- Templates in views/: the sniff would turn "<?php if ( x ) : ?>" into four lines. -->
		<exclude-pattern>*/views/*</exclude-pattern>
	</rule>
	<rule ref="SlevomatCodingStandard.ControlStructures.JumpStatementsSpacing">
		<properties>
			<property name="linesCountBefore" value="1"/>
			<property name="linesCountBeforeFirst" value="0"/>
			<property name="linesCountAfter" value="0"/>
			<property name="linesCountAfterLast" value="0"/>
			<property name="allowSingleLineYieldStacking" value="true"/>
		</properties>
	</rule>

	<!--
	Templates in views/ are included by Core\View inside a function, so their variables
	(loop values, $args) are local, not globals.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>*/views/*</exclude-pattern>
	</rule>

	<!-- PHP versions the plugin supports (Requires PHP: 8.0). -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.0-"/>

	<!-- WordPress version the plugin supports (Requires at least: 6.2). -->
	<config name="minimum_wp_version" value="6.2"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="dovetail-studio"/>
			</property>
		</properties>
	</rule>

	<!-- Every global function, class, constant, option and hook must carry one of these prefixes. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="dovetail_studio"/>
				<element value="dovetail"/>
				<element value="DovetailStudio"/>
				<element value="DOVETAIL"/>
				<element value="dt_va"/>
				<element value="DT_VA"/>
			</property>
		</properties>
	</rule>
</ruleset>
